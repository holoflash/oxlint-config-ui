{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build --target=bun --production --outdir=dist ./src/index.ts --sourcemap",
    "start": "NODE_ENV=production bun src/index.ts",
    "lint": "oxlint --type-aware"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.0.4",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.22.0",
    "oxlint-tsgolint": "^0.2.0",
    "prettier": "3.6.2"
  }
}
