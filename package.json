{
  "name": "oxlint-tui",
  "version": "1.8.2",
  "description": "A lightweight, dependency-free Node.js TUI for browsing and running all available oxlint rules.",
  "keywords": [
    "cli",
    "configuration",
    "lint",
    "linter",
    "oxlint",
    "tui"
  ],
  "license": "MIT",
  "author": "holoflash",
  "bin": {
    "oxlint-tui": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx src/index.ts testconfig.json",
    "lint": "oxlint --type-aware --type-check --format=stylish",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "gen": "tsx scripts/generate-rule-descriptions.ts",
    "build": "tsdown && cp src/oxlint/rule-descriptions.br dist/",
    "build-run": "npm run gen && npm run build && node dist/index.mjs",
    "prepublishOnly": "npm run gen && npm run build"
  },
  "devDependencies": {
    "@types/node": "25.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260211.1",
    "husky": "9.1.7",
    "oxfmt": "0.33.0",
    "oxlint": "1.48.0",
    "oxlint-tsgolint": "0.14.0",
    "tsdown": "0.20.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=16"
  }
}
