{
  "name": "oxlint-tui",
  "version": "1.8.8",
  "description": "A lightweight, dependency-free Node.js TUI for browsing and running all available oxlint rules.",
  "keywords": [
    "cli",
    "configuration",
    "lint",
    "linter",
    "oxlint",
    "tui"
  ],
  "license": "MIT",
  "author": "holoflash",
  "bin": {
    "oxlint-tui": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "tsx src/index.ts testconfig.json",
    "lint": "vp lint --type-aware --type-check --format=stylish",
    "format": "vp fmt",
    "format-check": "vp fmt --check",
    "gen": "tsx scripts/generate-rule-descriptions.ts",
    "build": "vp pack && cp src/oxlint/rule-descriptions.br dist/",
    "build-run": "pnpm run gen && pnpm run build && node dist/index.mjs",
    "prepublishOnly": "pnpm run gen && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite-plus": "0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@11.12.0"
}
