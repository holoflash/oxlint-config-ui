{
  "name": "oxlint-tui",
  "version": "1.5.3",
  "description": "A Node TUI Oxlint rules and configuration browser",
  "keywords": [
    "cli",
    "configuration",
    "lint",
    "linter",
    "oxlint",
    "tui"
  ],
  "license": "MIT",
  "author": "holoflash",
  "bin": {
    "oxlint-tui": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx src/index.ts",
    "lint": "oxlint --type-aware --format=stylish",
    "type-check": "tsgo --noEmit",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "gen": "tsx scripts/generate-rule-descriptions.ts",
    "build": "tsdown && cp src/rule-descriptions.br dist/",
    "build-run": "npm run gen && npm run build && node dist/index.mjs"
  },
  "devDependencies": {
    "@types/node": "25.2.1",
    "@typescript/native-preview": "7.0.0-dev.20260202.1",
    "husky": "9.1.7",
    "oxfmt": "0.28.0",
    "oxlint": "1.43.0",
    "oxlint-tsgolint": "0.11.4",
    "tsdown": "0.20.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=16"
  }
}
